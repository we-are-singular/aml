{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "hooks": {
    "before:init": "npm run release:check --prefix ../..",
    "after:bump": "npm install --package-lock-only --ignore-scripts --prefix ../.. && git add ../../package-lock.json"
  },
  "git": {
    "commitMessage": "release(cli): v${version}",
    "requireBranch": "main",
    "tagAnnotation": "Release @aml-jsx/cli v${version}",
    "tagName": "cli-v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "@aml-jsx/cli v${version}"
  },
  "npm": {
    "publish": true
  }
}
