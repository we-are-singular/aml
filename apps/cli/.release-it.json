{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "verbose": true,
  "hooks": {
    "after:bump": [
      "npm install --package-lock-only --ignore-scripts --prefix ../..",
      "git add ../../package-lock.json",
      "npm run changelog:cli --prefix ../..",
      "npm run format --prefix ../.. -- apps/website/src/content/docs/docs/reference/changelog/cli.mdx",
      "git add ../../apps/website/src/content/docs/docs/reference/changelog/cli.mdx"
    ],
    "before:release": "npm run release:check --prefix ../.."
  },
  "git": {
    "changelog": "node ../../scripts/release-notes.ts cli ${from} ${to}",
    "commitMessage": "release(cli): v${version}",
    "requireBranch": "main",
    "tagAnnotation": "Release @aml-jsx/cli v${version}",
    "tagMatch": "cli-v*",
    "tagName": "cli-v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "@aml-jsx/cli v${version}"
  },
  "npm": {
    "publish": true
  }
}
