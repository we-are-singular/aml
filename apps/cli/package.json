{
  "name": "@aml-jsx/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "aml": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir dist && chmod +x dist/index.js",
    "dev": "vite-node src/index.ts",
    "lint": "tsc --noEmit && oxlint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --watch"
  },
  "dependencies": {
    "@aml-jsx/sdk": "*",
    "clipanion": "^3.2.1",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  }
}
