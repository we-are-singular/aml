{
  "name": "@aml-jsx/cli",
  "version": "0.3.1",
  "description": "Execute trusted Agent Markup Language TypeScript, TSX, and JavaScript workflows directly.",
  "keywords": [
    "agents",
    "ai",
    "cli",
    "jsx",
    "orchestration",
    "typescript",
    "workflows"
  ],
  "homepage": "https://agent-markup-language.com/docs/cli/",
  "bugs": {
    "url": "https://github.com/we-are-singular/aml/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-are-singular/aml.git",
    "directory": "apps/cli"
  },
  "bin": {
    "aml": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "vite-node src/index.ts",
    "lint": "tsc --noEmit && oxlint .",
    "package:check": "node scripts/check-package.ts",
    "prepublishOnly": "npm run build && npm run package:check",
    "release": "release-it",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0"
  },
  "devDependencies": {
    "@aml-jsx/sdk": "*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@aml-jsx/sdk": "*"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  }
}
