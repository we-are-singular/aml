---
import { withBase } from "../../config/site"
import ProviderMark from "./ProviderMark.astro"

import { docsProviderGroups } from "../../data/docs-provider-catalog"
---

<div class="provider-catalog">
  {
    docsProviderGroups.map(group => (
      <section class="provider-group">
        <div class="provider-group__intro">
          <p>{group.label}</p>
          <span>{group.description}</span>
        </div>
        <div class="provider-group__grid">
          {group.providers.map(provider => (
            <a href={withBase(provider.href)} class="provider-card">
              <ProviderMark name={provider.name} size="md" />
              <span>
                <strong>{provider.title}</strong>
                <small><code>{provider.factory}</code> · {provider.meta}</small>
                <b>{provider.bestFor}</b>
              </span>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</div>

<style>
  .provider-catalog {
    display: grid;
    gap: 2.4rem;
    margin: 2rem 0 3rem;
  }

  .provider-group {
    display: grid;
    gap: 1rem;
  }

  .provider-group__intro p {
    color: var(--sl-color-white);
    font-size: 1rem;
    font-weight: 650;
    margin: 0 0 0.2rem;
  }

  .provider-group__intro span {
    color: var(--sl-color-gray-2);
    font-size: 0.84rem;
  }

  .provider-group__grid {
    display: grid;
    gap: 0.72rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .provider-card {
    align-items: center;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.95rem;
    color: inherit;
    display: grid;
    gap: 0.85rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    padding: 0.9rem;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .provider-card:hover {
    border-color: color-mix(in srgb, var(--sl-color-accent) 40%, var(--sl-color-hairline-light));
    box-shadow: var(--aml-shadow-md);
    transform: translateY(-2px);
  }

  .provider-card strong,
  .provider-card small,
  .provider-card b {
    display: block;
  }

  .provider-card strong {
    color: var(--sl-color-white);
    font-size: 0.92rem;
    margin-bottom: 0.22rem;
  }

  .provider-card small {
    color: var(--sl-color-gray-2);
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .provider-card b {
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    margin-top: 0.45rem;
    text-transform: uppercase;
  }

  .provider-card i {
    color: var(--sl-color-gray-3);
    font-style: normal;
  }

  @media (max-width: 42rem) {
    .provider-group__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
