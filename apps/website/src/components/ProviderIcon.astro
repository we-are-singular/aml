---
/* eslint-disable no-undef -- Astro exposes this global inside component frontmatter. */
import { withBase } from "../config/site"
import type { ProviderIcon } from "../data/provider-catalog"

interface Props {
  icon: ProviderIcon
  class?: string
  loading?: "eager" | "lazy"
}

const { icon, class: className, loading = "lazy" } = Astro.props
---

{
  icon.type === "asset" ? (
    <img
      class:list={[className, { "rounded-[0.2rem] ring-1 ring-line-strong": icon.rounded }]}
      src={withBase(icon.path)}
      alt=""
      width="48"
      height="48"
      loading={loading}
      decoding="async"
    />
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {icon.name === "terminal" && <path d="m3 7 4 5-4 5M10 18h8" />}
      {icon.name === "folder" && <path d="M3.5 6.5h6l2 2h9v9a2 2 0 0 1-2 2h-15z" />}
      {icon.name === "files" && <path d="M7 4.5h8l3 3v12H7zm8 0v3h3M4 8v12h10" />}
      {
        icon.name === "volume" && (
          <>
            <ellipse cx="12" cy="5.5" rx="7.5" ry="3" />
            <path d="M4.5 5.5v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6m-15 6v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6" />
          </>
        )
      }
      {
        icon.name === "network" && (
          <>
            <circle cx="5" cy="12" r="2.5" />
            <circle cx="19" cy="6" r="2.5" />
            <circle cx="19" cy="18" r="2.5" />
            <path d="m7.3 11 9.4-4m-9.4 6 9.4 4" />
          </>
        )
      }
      {icon.name === "sftp" && <path d="M4 7h10m0 0-3-3m3 3-3 3M20 17H10m0 0 3-3m-3 3 3 3" />}
    </svg>
  )
}
