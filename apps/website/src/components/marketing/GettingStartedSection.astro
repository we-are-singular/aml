---
import { withBase } from "../../config/site"
import { highlightTsx } from "../../highlight"

const source = `import { Agent, AmlRuntime, opencodeAgent } from "@aml-jsx/sdk"

const runtime = new AmlRuntime({
  agentProvider: opencodeAgent({}),
})

const result = await runtime.evaluate(
  <Agent>Summarize this repository.</Agent>,
)
console.log(result)`

const highlightedSource = await highlightTsx(source, "github-light")
---

<section id="start" class="scroll-mt-20 border-t border-line bg-paper text-ink">
  <div class="mx-auto max-w-6xl px-5 py-24 sm:py-32">
    <p class="reveal font-mono text-[12px] uppercase tracking-[0.2em] text-resolve">get started</p>
    <div class="mt-3">
      <h2 class="reveal text-3xl font-bold tracking-tight [--reveal-delay:60ms] sm:text-5xl">
        Run your first agent
      </h2>
      <p class="reveal mt-5 text-[15px] leading-relaxed text-ink-soft [--reveal-delay:120ms]">
        Add AML to a Node.js 26+ TypeScript project. To run OpenCode, <a href={withBase("docs/providers/agents/opencode/")} class="text-ink-soft underline underline-offset-4 hover:text-ink">install its CLI and configure model credentials</a>.
      </p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
      <div class="magnetic-card reveal rounded-2xl border border-line bg-surface p-6">
        <div class="flex items-center justify-between">
          <p class="font-mono text-[12px] text-resolve">step 1</p>
          <button
            data-copy="npm install @aml-jsx/sdk"
            class="copy-btn rounded-md border border-line-strong px-2 py-0.5 font-mono text-[10.5px] text-ink-soft transition-colors hover:border-ink-soft hover:text-ink"
          >
            copy
          </button>
        </div>
        <h3 class="mt-3 font-semibold">Install AML</h3>
        <pre
          class="mt-4 overflow-x-auto rounded-lg bg-[#f0f2f6] px-4 py-3 font-mono text-[12.5px] text-ink"
        ><code>$ npm install <span class="text-[#087653]">@aml-jsx/sdk</span></code></pre>
        <div class="mt-5 border-t border-line pt-5">
          <div class="flex items-center justify-between gap-3">
            <p class="text-[12.5px] font-medium text-ink-soft">Coding with an agent?</p>
            <button
              data-copy="npx skills add we-are-singular/aml --skill aml-jsx"
              class="copy-btn rounded-md border border-line-strong px-2 py-0.5 font-mono text-[10.5px] text-ink-soft transition-colors hover:border-ink-soft hover:text-ink"
            >
              copy
            </button>
          </div>
          <pre
            class="mt-3 overflow-x-auto rounded-lg bg-[#f0f2f6] px-4 py-3 font-mono text-[11.5px] text-ink"
          ><code>$ npx skills add <span class="text-[#087653]">we-are-singular/aml</span> --skill aml-jsx</code></pre>
        </div>
      </div>

      <div
        class="magnetic-card reveal rounded-2xl border border-line bg-surface p-6 [--reveal-delay:80ms] lg:col-start-1 lg:row-start-2"
      >
        <div class="flex items-center justify-between">
          <p class="font-mono text-[12px] text-resolve">step 2</p>
          <button
            data-copy-target="start-tsconfig"
            class="copy-btn rounded-md border border-line-strong px-2 py-0.5 font-mono text-[10.5px] text-ink-soft transition-colors hover:border-ink-soft hover:text-ink"
          >
            copy
          </button>
        </div>
        <h3 class="mt-3 font-semibold">Point JSX at AML</h3>
        <pre
          id="start-tsconfig"
          class="mt-4 overflow-x-auto rounded-lg bg-[#f0f2f6] px-4 py-3 font-mono text-[12.5px] leading-relaxed text-ink"
        ><code>&#123;
  <span class="text-[#0550ae]">"compilerOptions"</span>: &#123;
    <span class="text-[#0550ae]">"jsx"</span>: <span class="text-[#0a3069]">"react-jsx"</span>,
    <span class="text-[#0550ae]">"jsxImportSource"</span>: <span class="text-[#0a3069]">"@aml-jsx/sdk"</span>
  &#125;
&#125;</code></pre>
      </div>

      <div
        class="magnetic-card reveal rounded-2xl border border-line bg-surface p-6 [--reveal-delay:160ms] lg:col-start-2 lg:row-start-1 lg:row-span-2"
      >
        <div class="flex items-center justify-between">
          <p class="font-mono text-[12px] text-resolve">step 3</p>
          <button
            data-copy-target="start-agent"
            class="copy-btn rounded-md border border-line-strong px-2 py-0.5 font-mono text-[10.5px] text-ink-soft transition-colors hover:border-ink-soft hover:text-ink"
          >
            copy
          </button>
        </div>
        <h3 class="mt-3 font-semibold">Run an agent</h3>
        <pre
          id="start-agent"
          class="mt-4 overflow-x-auto rounded-lg bg-[#f0f2f6] px-4 py-3 font-mono text-[12.5px] leading-relaxed text-ink"
        ><code set:html={highlightedSource} /></pre>
        <p class="mt-4 text-[12.5px] leading-relaxed text-ink-soft">
          Save as <code>workflow.tsx</code> in your project.
        </p>
      </div>
    </div>

    <div class="reveal mt-8 flex flex-wrap gap-x-6 gap-y-3 [--reveal-delay:220ms]">
      <a
        href={withBase("docs/getting-started/")}
        class="font-mono text-[12px] font-semibold text-resolve underline-offset-4 hover:underline"
      >
        Follow the complete setup guide →
      </a>
      <a
        href={withBase("docs/ast/")}
        class="font-mono text-[12px] font-semibold text-ink-soft underline-offset-4 hover:text-ink hover:underline"
      >
        JSX configuration →
      </a>
    </div>
  </div>
</section>
