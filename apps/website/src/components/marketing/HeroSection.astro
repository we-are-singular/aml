---
import { withBase } from "../../config/site.js"
---

<section class="relative overflow-hidden pt-14">
  <div class="dot-grid absolute inset-0" aria-hidden="true"></div>
  <div class="hero-vignette absolute inset-0" aria-hidden="true"></div>
  <div id="hero-glow" class="pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 pb-28 pt-14 sm:pb-40 sm:pt-20">
    <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="lg:py-6">
        <h1
          class="reveal text-5xl font-semibold leading-[1.08] tracking-tight [--reveal-delay:80ms] sm:text-6xl lg:text-[64px]"
        >
          Build AI agents<br />
          with{" "}
          <span class="inline-block text-resolve">&lt;JSX /&gt;</span>
        </h1>

        <p
          class="reveal mt-8 text-lg leading-relaxed text-ink-soft [--reveal-delay:160ms]"
        >
          AML is a TypeScript framework for building AI agents. Write reusable JSX components to connect agents,
          give them tools, and pass their results to the next step.
        </p>

        <div class="reveal mt-7 flex flex-wrap items-center gap-3 [--reveal-delay:240ms]">
          <a
            href="#how"
            class="group flex items-center gap-2 rounded-full bg-resolve px-6 py-3 text-[15px] font-semibold text-white shadow-lg shadow-resolve/25 transition-all hover:shadow-xl hover:shadow-resolve/35"
          >
            <span
              class="grid size-5 place-items-center rounded-full bg-white/20 transition-transform group-hover:scale-110"
            >
              <svg viewBox="0 0 16 16" class="ml-px size-2.5 fill-current" aria-hidden="true">
                <path d="M4 2.75v10.5L13 8 4 2.75Z" />
              </svg>
            </span>
            See how it works
          </a>
          <a
            href={withBase("docs/getting-started/")}
            class="rounded-full border border-line-strong bg-surface px-6 py-3 text-[15px] font-semibold transition-colors hover:border-ink"
          >
            Build your first agent
          </a>
        </div>
      </div>

      <!-- hero canvas: a tree continuously resolving -->
      <div class="reveal relative [--reveal-delay:200ms]">
        <div
          class="relative rounded-2xl border border-line bg-surface/80 shadow-2xl shadow-ink/5 backdrop-blur-sm"
        >
          <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
            <div class="flex items-center gap-1.5">
              <span class="size-2.5 rounded-full bg-line-strong"></span>
              <span class="size-2.5 rounded-full bg-line-strong"></span>
              <span class="size-2.5 rounded-full bg-ok"></span>
            </div>
            <p class="font-mono text-[11px] text-muted">WeeklyStandup.tsx</p>
          </div>
          <canvas id="hero-canvas" class="block h-[310px] w-full sm:h-[390px]"></canvas>
          <div class="flex items-center justify-between border-t border-line px-4 py-2 font-mono text-[11px]">
            <span class="flex items-center gap-1.5 text-muted">
              <span class="size-2 rounded-full bg-resolve"></span> resolving
              <span class="ml-2 size-2 rounded-full bg-signal"></span> running
              <span class="ml-2 size-2 rounded-full bg-ok"></span> resolved
            </span>
            <span id="hero-cycle" class="text-muted">cycle 1</span>
          </div>
        </div>

        <div
          class="absolute -left-4 bottom-28 hidden rounded-lg border border-line bg-surface px-3 py-1.5 font-mono text-[11px] text-ink-soft shadow-md sm:block"
          data-float="1"
        >
          evaluate(<span class="text-resolve">&lt;WeeklyStandup /&gt;</span>)
        </div>
        <div
          class="absolute -right-3 top-20 hidden rounded-lg border border-line bg-surface px-3 py-1.5 font-mono text-[11px] text-ink-soft shadow-md sm:block"
          data-float="2"
        >
          &lt;Parallel&gt;<span class="text-signal">gatherers</span>&lt;/Parallel&gt;
        </div>
        <!-- The elevator pitch stays visible on mobile: it is the first concrete glimpse of AML syntax. -->
        <div
          class="relative z-10 ml-auto mt-3 w-full max-w-sm rounded-xl border border-line bg-surface/95 px-4 py-3 font-mono text-[11.5px] leading-[1.75] shadow-lg backdrop-blur-sm sm:absolute sm:-bottom-4 sm:-right-10 sm:mt-0 sm:w-56"
          data-float="3"
        >
          <p class="font-mono">
            <span class="text-muted">&lt;</span><span class="text-agent">Agent</span>{" "}
            <span class="text-resolve">provider</span><span class="text-muted">=</span>&#123;codex&#125;<span
              class="text-muted"
              >&gt;</span
            >
          </p>
          <p class="pl-4 font-mono">
            <span class="text-muted">&lt;</span><span class="text-ok">Mcp</span>{" "}
            <span class="text-resolve">use</span><span class="text-muted">=</span>&#123;slack&#125;{" "}
            <span class="text-muted">/&gt;</span>
          </p>
          <p class="pl-4 font-mono text-ink">post our weekly standup:</p>
          <p class="pl-4 font-mono text-ink"><span class="text-signal">&#123;synthesis&#125;</span></p>
          <p class="font-mono">
            <span class="text-muted">&lt;/</span><span class="text-agent">Agent</span
            ><span class="text-muted">&gt;</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
