---
import { withBase } from "../../config/site"
---

<section id="reference" class="scroll-mt-20 border-y border-line bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-24 sm:py-32">
    <p class="reveal font-mono text-[12px] uppercase tracking-[0.2em] text-resolve">reference</p>
    <h2 class="reveal mt-3 text-3xl font-bold tracking-tight [--reveal-delay:60ms] sm:text-5xl">
      Small enough to learn in one sitting
    </h2>
    <p class="reveal mt-5 text-[15px] leading-relaxed text-ink-soft [--reveal-delay:120ms]">
      Twelve primitives and a focused set of runtime APIs. Everything else is ordinary JavaScript — control flow and
      data transformation included.
    </p>
    <a
      href={withBase("docs/reference/primitives/")}
      class="reveal mt-5 inline-flex font-mono text-[12px] font-semibold text-resolve underline-offset-4 [--reveal-delay:150ms] hover:underline"
    >
      Browse all primitive guides →
    </a>

    <div class="mt-14 grid gap-8 lg:grid-cols-[minmax(220px,0.8fr)_2.2fr]">
      <!-- Bounded index: it stays useful without making the whole page as tall as the API list. -->
      <div class="reveal lg:sticky lg:top-20 lg:self-start">
        <div id="ref-list" class="ref-list-scroll space-y-6 lg:pr-3" role="tree" aria-label="AML reference"></div>
      </div>

      <!-- The selected concept remains alongside the independently scrolling index. -->
      <div class="reveal min-w-0 [--reveal-delay:120ms] lg:sticky lg:top-20 lg:self-start">
        <div class="overflow-hidden rounded-2xl border border-line bg-paper">
          <div
            class="flex flex-wrap items-center justify-between gap-3 border-b border-line bg-surface px-6 py-4"
          >
            <div>
              <h3 id="ref-name" class="font-mono text-xl font-semibold"></h3>
              <p id="ref-kind" class="mt-0.5 font-mono text-[11px] uppercase tracking-wider text-muted"></p>
            </div>
            <code
              id="ref-signature"
              class="rounded-lg border border-line bg-paper px-3 py-1.5 font-mono text-[11.5px] text-ink-soft"
            ></code>
          </div>
          <div class="px-6 py-5">
            <p id="ref-description" class="max-w-prose text-[15px] leading-relaxed text-ink-soft"></p>
            <p
              id="ref-note"
              class="mt-3 hidden max-w-prose rounded-lg border border-resolve/25 bg-resolve-soft px-3.5 py-2.5 text-[13px] leading-relaxed text-ink-soft"
            ></p>
            <a
              id="ref-docs"
              class="mt-5 inline-flex font-mono text-[12px] font-semibold text-resolve underline-offset-4 hover:underline"
            ></a>
          </div>
          <div class="border-t border-line">
            <div class="flex items-center justify-between bg-[#12110d] px-4 py-2">
              <span id="ref-example-file" class="font-mono text-[11px] text-white/60"></span>
              <button
                id="ref-copy"
                class="rounded-md border border-white/15 px-2.5 py-1 font-mono text-[11px] text-white/70 transition-colors hover:border-white/40 hover:text-white"
              >
                copy
              </button>
            </div>
            <pre
              id="ref-example"
              class="code-block max-h-[480px] overflow-auto px-4 py-3.5 text-[12.5px] leading-[1.7]"
            ></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
