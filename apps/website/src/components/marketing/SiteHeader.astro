---
/* eslint-disable no-undef -- Astro exposes this global inside component frontmatter. */
import { withBase } from "../../config/site"
import { navigationItems } from "../../data/marketing"

interface Props {
  sdkVersion: string
}

const { sdkVersion } = Astro.props
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line/70 bg-paper/85 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5">
    <a href="#top" class="group flex items-center gap-2.5">
      <span class="select-none font-mono text-[15px] font-semibold tracking-tight" aria-label="AML">
        <span class="text-muted">&lt;</span><span class="text-ink">aml</span><span class="text-resolve"> /</span
        ><span class="text-muted">&gt;</span>
      </span>
    </a>

    <div class="hidden items-center gap-6 text-[13.5px] font-medium text-ink-soft md:flex">
      {
        navigationItems.map(item => (
          <a class="link-underline hover:text-ink" href={item.isBaseRelative ? withBase(item.href) : item.href}>
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href="https://github.com/we-are-singular/aml/releases"
        target="_blank"
        rel="noreferrer"
        class="rounded-full border border-line bg-surface px-2.5 py-1 font-mono text-[11px] text-muted transition-colors hover:border-resolve hover:text-resolve"
      >
        v{sdkVersion}
      </a>
      <a
        href="https://github.com/we-are-singular/aml"
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-1.5 rounded-full bg-ink px-3.5 py-1.5 text-[13px] font-medium text-paper transition-colors hover:bg-resolve"
      >
        <svg viewBox="0 0 16 16" class="size-3.5 fill-current" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          />
        </svg>
        GitHub
      </a>
      <details class="group relative md:hidden" data-mobile-nav>
        <summary
          class="flex size-8 cursor-pointer list-none items-center justify-center rounded-full border border-line bg-surface text-ink transition-colors hover:border-resolve hover:text-resolve [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation"
        >
          <svg viewBox="0 0 16 16" class="size-4 fill-none stroke-current" aria-hidden="true">
            <path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11" stroke-linecap="round"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 top-[calc(100%+0.65rem)] grid w-56 gap-1 rounded-xl border border-line bg-surface/95 p-2 shadow-[0_18px_45px_rgb(23_23_17/0.14)] backdrop-blur-md"
        >
          {
            navigationItems.map(item => (
              <a
                class="rounded-lg px-3 py-2 text-sm font-medium text-ink-soft transition-colors hover:bg-resolve-soft hover:text-resolve"
                href={item.isBaseRelative ? withBase(item.href) : item.href}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  /* eslint-disable no-undef -- This script runs in the browser. */
  document.querySelectorAll<HTMLAnchorElement>("[data-mobile-nav] a").forEach(link => {
    link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"))
  })
</script>
