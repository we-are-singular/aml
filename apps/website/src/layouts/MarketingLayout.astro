---
/* eslint-disable no-undef -- Astro exposes framework globals inside component frontmatter. */
import "../style.css"
import FontPreloads from "../components/FontPreloads.astro"
import { siteMetadata, withBase } from "../config/site"

interface Props {
  title?: string
  description?: string
  structuredData?: Record<string, unknown>
}

const {
  title = siteMetadata.title,
  description = siteMetadata.description,
  structuredData,
} = Astro.props
const site = Astro.site ?? new URL("https://agent-markup-language.com")
const canonicalUrl = new URL(withBase(), site)
const imageUrl = new URL(withBase(siteMetadata.image.path), site)
const llmsUrl = new URL(withBase("llms.txt"), site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={siteMetadata.shortName} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#fafaf7" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={withBase("sitemap-index.xml")} />
    <link rel="describedby" href={llmsUrl} type="text/plain" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteMetadata.socialDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteMetadata.name} />
    <meta property="og:locale" content={siteMetadata.locale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content={siteMetadata.image.type} />
    <meta property="og:image:width" content={String(siteMetadata.image.width)} />
    <meta property="og:image:height" content={String(siteMetadata.image.height)} />
    <meta property="og:image:alt" content={siteMetadata.image.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={siteMetadata.socialDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={siteMetadata.image.alt} />

    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="icon" href={withBase("favicon.ico")} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("favicon-32x32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase("favicon-16x16.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("site.webmanifest")} />
    <FontPreloads />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <slot name="head" />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="6d1d4961-e15b-44b0-ae81-36180d7aeec8"
    ></script>
    <script src="../main.ts"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
