{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["config/**", "tsconfig.json"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "example": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["AML_*", "OPENCODE_API_KEY"]
    },
    "package:check": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
