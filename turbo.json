{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "example": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["@aml/sdk#build"],
      "outputs": []
    }
  }
}
