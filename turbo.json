{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["config/**", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@aml-jsx/website#build": {
      "env": ["SITE_BASE", "SITE_URL"],
      "outputs": ["dist/**"]
    },
    "example": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["AML_*", "OPENCODE_API_KEY"]
    },
    "package:check": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
