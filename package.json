{
  "name": "agent-markup-language",
  "private": true,
  "workspaces": [
    "apps/*",
    "examples",
    "sdk",
    "providers/*/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "example": "turbo run example --filter=@aml-jsx/examples --",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "npm run typecheck && oxlint .",
    "lint:fix": "oxlint --fix .",
    "pack:check": "turbo run package:check",
    "prepare": "husky",
    "release": "npm run release --workspace=@aml-jsx/sdk --",
    "release:check": "npm run format:check && npm run lint && npm run test && npm run build && npm run pack:check",
    "smoke": "vite-node sdk/tests/smoke/run-smoke.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@agentclientprotocol/codex-acp": "1.1.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@openai/codex": "0.145.0",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "opencode-ai": "1.18.9",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "pi-acp": "^0.0.33",
    "pi-mcp-adapter": "^2.16.0",
    "release-it": "^21.0.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.18.0"
}
