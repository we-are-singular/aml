{
  "name": "agent-markup-language",
  "private": true,
  "workspaces": [
    "apps/*",
    "examples",
    "sdk",
    "providers/*/*"
  ],
  "type": "module",
  "scripts": {
    "aml": "vite-node apps/cli/src/index.ts",
    "build": "turbo build",
    "changelog:cli": "npm run aml -- run ./scripts/changelog.aml.tsx --entry cli --trace",
    "changelog:sandbox": "npm run aml -- run ./scripts/changelog.aml.tsx --entry sandbox --trace",
    "changelog:sdk": "npm run aml -- run ./scripts/changelog.aml.tsx --entry sdk --trace",
    "dev": "npm run dev --workspace=@aml-jsx/website --",
    "example": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run example --filter=@aml-jsx/examples --",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo lint",
    "lint:fix": "oxlint --fix .",
    "pack:check": "turbo run package:check",
    "prepare": "husky",
    "release": "npm run release:sdk --",
    "release:cli": "npm run release --workspace=@aml-jsx/cli --",
    "release:check": "npm run format:check && npm run lint && npm run test && npm run build && npm run pack:check",
    "release:sandbox": "npm run release --prefix images/sandbox --",
    "release:sdk": "npm run release --workspace=@aml-jsx/sdk --",
    "smoke": "vite-node sdk/tests/smoke/run-smoke.ts",
    "smoke:kitchen-sink": "vite-node sdk/tests/smoke/kitchen-sink.smoke.tsx",
    "test": "turbo test"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.91.0",
    "@agentclientprotocol/codex-acp": "2.2.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@github/copilot": "1.0.98",
    "@openai/codex": "0.162.1",
    "@types/node": "^26.6.5",
    "glm-acp-agent": "1.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "opencode-ai": "1.19.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.76.0",
    "pi-acp": "^0.0.34",
    "pi-mcp-adapter": "5.3.1",
    "release-it": "^21.0.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "basic-ftp": "6.2.3",
    "postcss-nested": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.0"
}
