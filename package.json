{
  "name": "agent-markup-language",
  "private": true,
  "workspaces": [
    "apps/*",
    "examples",
    "sdk",
    "providers/*/*"
  ],
  "type": "module",
  "scripts": {
    "aml": "vite-node apps/cli/src/index.ts",
    "build": "turbo build",
    "changelog:cli": "npm run aml -- run ./scripts/changelog.aml.tsx --entry cli --trace",
    "changelog:sdk": "npm run aml -- run ./scripts/changelog.aml.tsx --entry sdk --trace",
    "dev": "npm run dev --workspace=@aml-jsx/website --",
    "example": "turbo run example --filter=@aml-jsx/examples --",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo lint",
    "lint:fix": "oxlint --fix .",
    "pack:check": "turbo run package:check",
    "prepare": "husky",
    "release": "npm run release:sdk --",
    "release:cli": "npm run release --workspace=@aml-jsx/cli --",
    "release:check": "npm run format:check && npm run lint && npm run test && npm run build && npm run pack:check",
    "release:docker": "npm run release --prefix images/aml-agent-sandbox --",
    "release:sdk": "npm run release --workspace=@aml-jsx/sdk --",
    "smoke": "vite-node sdk/tests/smoke/run-smoke.ts",
    "smoke:kitchen-sink": "vite-node sdk/tests/smoke/kitchen-sink.smoke.tsx",
    "test": "turbo test"
  },
  "devDependencies": {
    "@agentclientprotocol/codex-acp": "1.4.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@github/copilot": "1.0.80",
    "@openai/codex": "0.147.0",
    "@types/node": "^26.1.1",
    "glm-acp-agent": "1.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "opencode-ai": "1.18.18",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "pi-acp": "^0.0.33",
    "pi-mcp-adapter": "2.26.0",
    "release-it": "^21.0.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.0"
}
