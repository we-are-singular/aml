{
  "name": "@aml/workspace-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@aml/sdk": "*",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  },
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json",
    "pack:check": "npm run build && node scripts/check-package.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
