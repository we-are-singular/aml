{
  "name": "@aml-jsx/agent-sandbox-image",
  "version": "0.1.0",
  "private": true,
  "description": "AML's portable, tested runtime image for ACP coding Agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/we-are-singular/aml.git",
    "directory": "images/aml-agent-sandbox"
  },
  "scripts": {
    "build": "docker build --platform linux/amd64 --tag aml-agent-sandbox:dev .",
    "check": "npm run check:writable && npm run check:read-only",
    "check:read-only": "docker run --rm --platform linux/amd64 --env AML_VERIFY_WORKSPACE_ACCESS=read-only --volume $PWD/fixtures/clean-workspace:/workspace:ro --volume $PWD/verify.sh:/verify.sh:ro ${AML_AGENT_SANDBOX_IMAGE:-aml-agent-sandbox:dev} /verify.sh",
    "check:writable": "docker run --rm --platform linux/amd64 --env AML_VERIFY_WORKSPACE_ACCESS=read-write --tmpfs /workspace:rw,uid=1000,gid=1000 --volume $PWD/fixtures/clean-workspace:/fixture:ro --volume $PWD/verify.sh:/verify.sh:ro ${AML_AGENT_SANDBOX_IMAGE:-aml-agent-sandbox:dev} /verify.sh",
    "release": "node scripts/release.mjs",
    "release:check": "npm audit --omit=dev && npm run build && npm run check",
    "test": "node --test scripts/*.test.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.4.0",
    "@aml-jsx/cli": "0.2.1",
    "@aml-jsx/sdk": "0.5.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@github/copilot": "1.0.80",
    "@openai/codex": "0.147.0",
    "glm-acp-agent": "1.5.0",
    "opencode-ai": "1.18.18",
    "pi-acp": "0.0.33",
    "pi-mcp-adapter": "2.26.0"
  },
  "devDependencies": {
    "release-it": "^21.0.0"
  }
}
