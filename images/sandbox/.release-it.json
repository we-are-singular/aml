{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "verbose": true,
  "hooks": {
    "after:bump": [
      "npm run update:aml",
      "timeout --signal=INT --kill-after=15s 10m npm run changelog:sandbox --prefix ../..",
      "npm run format --prefix ../.. -- images/sandbox/CHANGELOG.md",
      "git add package.json package-lock.json CHANGELOG.md"
    ],
    "before:release": "npm run release:check",
    "after:git:release": "node scripts/publish.mjs ${version}"
  },
  "git": {
    "changelog": "node ../../scripts/release-notes.ts sandbox ${from} ${to}",
    "commitMessage": "release(sandbox): v${version}",
    "requireBranch": "main",
    "tagAnnotation": "Release AML Agent Sandbox v${version}",
    "tagMatch": "[ds]*-v*",
    "tagName": "sandbox-v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "sandbox v${version}"
  },
  "npm": {
    "publish": false
  }
}
