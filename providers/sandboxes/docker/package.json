{
  "name": "@aml-jsx/sandbox-docker",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json",
    "package:check": "node scripts/check-package.ts",
    "test": "vitest run",
    "test:integration": "AML_DOCKER_TEST=1 vitest run tests/docker-sandbox.integration.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aml-jsx/sdk": "*",
    "@types/dockerode": "^4.0.1",
    "dockerode": "^5.0.1"
  }
}
