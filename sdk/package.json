{
  "name": "@aml-jsx/sdk",
  "version": "0.1.0",
  "description": "An asynchronous TypeScript and JSX runtime for composing provider-agnostic agent workflows.",
  "keywords": [
    "agents",
    "ai",
    "jsx",
    "orchestration",
    "typescript",
    "workflows"
  ],
  "homepage": "https://aml.wearesingular.com/",
  "bugs": {
    "url": "https://github.com/we-are-singular/aml/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-are-singular/aml.git",
    "directory": "sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/sdk/src/index.d.ts",
  "imports": {
    "#aml/jsx-dev-runtime": {
      "aml-source": "./src/jsx-dev-runtime.ts",
      "types": "./dist/sdk/src/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "#aml/jsx-runtime": {
      "aml-source": "./src/jsx-runtime.ts",
      "types": "./dist/sdk/src/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/sdk/src/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/sdk/src/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./testing": {
      "types": "./dist/sdk/src/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "package:check": "node scripts/check-package.ts",
    "prepublishOnly": "npm run build && npm run package:check",
    "release": "release-it",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "0.145.0",
    "@opencode-ai/sdk": "1.18.5",
    "@standard-schema/spec": "^1.1.0",
    "@types/dockerode": "^4.0.1",
    "dockerode": "^5.0.1",
    "execa": "^10.0.0",
    "hookable": "^6.1.1",
    "p-limit": "^7.3.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "@typescript/typescript6": "^6.0.2",
    "vite-plugin-dts": "^5.0.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
