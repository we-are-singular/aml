{
  "name": "@aml-jsx/sdk",
  "version": "0.9.1",
  "description": "A TypeScript framework for building AI agents and multi-agent applications with JSX.",
  "keywords": [
    "agents",
    "ai",
    "jsx",
    "orchestration",
    "typescript",
    "workflows"
  ],
  "homepage": "https://agent-markup-language.com/",
  "bugs": {
    "url": "https://github.com/we-are-singular/aml/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-are-singular/aml.git",
    "directory": "sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/sdk/src/index.d.ts",
  "imports": {
    "#aml/jsx-dev-runtime": {
      "aml-source": "./src/jsx-dev-runtime.ts",
      "types": "./dist/sdk/src/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "#aml/jsx-runtime": {
      "aml-source": "./src/jsx-runtime.ts",
      "types": "./dist/sdk/src/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/sdk/src/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/sdk/src/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./testing": {
      "types": "./dist/sdk/src/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "docs:check": "node scripts/check-public-api-docs.ts",
    "lint": "tsc --noEmit && oxlint . && npm run docs:check",
    "package:check": "node scripts/check-package.ts",
    "prepublishOnly": "npm run build && npm run package:check",
    "release": "release-it",
    "test": "vitest run",
    "smoke": "vite-node tests/smoke/run-smoke.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@daytona/sdk": "0.224.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode-ai/sdk": "1.19.4",
    "@standard-schema/spec": "^1.1.0",
    "execa": "^10.1.1",
    "globby": "^16.2.4",
    "hookable": "^6.1.2",
    "modal": "0.11.0",
    "p-limit": "^7.3.3",
    "proper-lockfile": "^4.1.2",
    "tar": "7.5.22",
    "typebox": "1.3.37",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "@typescript/typescript6": "^6.0.2",
    "vite-plugin-dts": "^5.1.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
