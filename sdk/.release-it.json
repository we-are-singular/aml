{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "hooks": {
    "after:git:init": "node ../scripts/check-release-branch.ts",
    "after:bump": "npm install --package-lock-only --ignore-scripts --prefix .. && git add ../package-lock.json",
    "before:release": "npm run release:check --prefix .."
  },
  "git": {
    "changelog": "node ../scripts/release-notes.ts sdk ${from} ${to}",
    "commitMessage": "release: v${version}",
    "requireBranch": "main",
    "tagAnnotation": "Release v${version}",
    "tagMatch": "v[0-9]*",
    "tagName": "v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "npm": {
    "publish": true
  }
}
