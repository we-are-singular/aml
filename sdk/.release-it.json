{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "verbose": true,
  "hooks": {
    "after:bump": [
      "npm pkg set \"devDependencies.@aml-jsx/sdk=^${version}\" \"peerDependencies.@aml-jsx/sdk=^${version}\" --workspace=@aml-jsx/cli --prefix ..",
      "git add ../apps/cli/package.json",
      "timeout --signal=INT --kill-after=15s 10m npm run changelog:sdk --prefix ..",
      "npm run format --prefix .. -- apps/website/src/content/docs/docs/reference/changelog/sdk.md",
      "git add ../apps/website/src/content/docs/docs/reference/changelog/sdk.md",
      "npm install --package-lock-only --ignore-scripts --prefix ..",
      "git add ../package-lock.json"
    ],
    "before:release": "npm run release:check --prefix .."
  },
  "git": {
    "changelog": "node ../scripts/release-notes.ts sdk ${from} ${to}",
    "commitMessage": "release: v${version}",
    "requireBranch": "main",
    "tagAnnotation": "Release v${version}",
    "tagMatch": "v[0-9]*",
    "tagName": "v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "sdk v${version}"
  },
  "npm": {
    "publish": true
  }
}
