{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "..",
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../providers/agents/codex/src/**/*.ts",
    "../providers/agents/opencode/src/**/*.ts",
    "../providers/agents/pi/src/**/*.ts",
    "../providers/sandboxes/docker/src/**/*.ts",
    "../providers/sandboxes/daytona/src/**/*.ts",
    "../providers/sandboxes/local/src/**/*.ts",
    "../providers/sandboxes/modal/src/**/*.ts",
    "../providers/workspaces/local/src/**/*.ts"
  ],
  "exclude": ["scripts", "tests", "vite.config.ts"]
}
